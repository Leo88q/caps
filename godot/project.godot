; Engine configuration file for Gutter Caps pop-n-shoot casual ECS
; Watchtower OS v3 Ideal Free Stack (33 components, sub-10ms gasless UX)

[application]
config/name="Gutter Caps"
config/description="Casual pop-n-shoot ECS game integrated with MagicBlock ER, Arcium, and Watchtower OS v3"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")

[autoload]
SolanaClient="*res://scripts/solana_client.gd"
WalletAdapter="*res://scripts/wallet_adapter.gd"
AnchorProgram="*res://scripts/anchor_program.gd"
SessionKeyManager="*res://scripts/session_key_manager.gd"
EcsWorld="*res://scripts/ecs_world.gd"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
